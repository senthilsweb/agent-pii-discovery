# Committed twin of the gitignored .env — the operator writes the real one.
# Full meaning of every variable: docs/configuration.md

# Engine + models (no defaults — unset fails at startup)
PII_ENGINE=presidio_genai            # presidio | presidio_genai | genai_only
MODEL_PII_EXTRACTOR=claude-opus-5
# MODEL=                             # generic fallback for roles without an override
# PII_SYSTEM_PROMPT_FILE=agent/skills/detection_prompt.md
# PII_DETECTION_CONCURRENCY=5

# Managed Agents control plane
ANTHROPIC_API_KEY=sk-ant-...
PII_AGENT_ID=agent_...
PII_AGENT_VERSION=1
PII_ENVIRONMENT_ID=env_...

# Storage (credentials stay host-side; never enter the sandbox)
OBJECT_STORE_BUCKET=agent-pii-discovery-dev
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY_ID=...
OBJECT_STORE_SECRET_ACCESS_KEY=...
# OBJECT_STORE_ENDPOINT=http://localhost:9000   # MinIO for local dev
# PII_DB_PATH=data/pii.duckdb

# Observability (missing backend = one logged warning, never a failed scan)
ARIZE_SPACE_ID=...
ARIZE_API_KEY=...
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006   # dev-only fan-out
TELEMETRY_RECORD_IO=false            # true only in offline/dev — document text in spans
